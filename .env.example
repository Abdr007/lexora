# ─────────────────────────────────────────────────────────────────────────────
# Lexora configuration. Copy to .env and fill in what you need.
#
# EVERY VALUE HERE IS OPTIONAL. With an empty .env the system runs end to end:
# embedded Qdrant on disk, local ONNX embedding and reranking, and a deterministic
# extractive answerer. Adding a key upgrades a stage; it never unlocks one.
# ─────────────────────────────────────────────────────────────────────────────

# ── Claude ───────────────────────────────────────────────────────────────────
# Without this, LEXORA runs in offline-extractive mode: retrieval, reranking, the
# refusal gate and citation verification all run and are measurable; answers are
# quoted from the corpus rather than written. Every response is labelled
# "offline-extractive" through the API and in the UI so a number measured in that
# mode cannot be mistaken for a Claude number.
LEXORA_ANTHROPIC_API_KEY=
# auto (default) | anthropic (fail loudly without a key) | offline (never call out)
LEXORA_LLM_MODE=auto
LEXORA_ANSWER_MODEL=claude-sonnet-4-6
LEXORA_GUARD_MODEL=claude-haiku-4-5-20251001

# ── Vector store ─────────────────────────────────────────────────────────────
# Leave BOTH unset to run Qdrant embedded on disk under var/qdrant — no account,
# no credentials, no network. Set both to use the Qdrant Cloud free tier instead;
# the code path is identical.
LEXORA_QDRANT_URL=
LEXORA_QDRANT_API_KEY=
LEXORA_QDRANT_COLLECTION=lexora_chunks

# ── Observability ────────────────────────────────────────────────────────────
# Optional. Traces every model call (the Haiku gate and the Sonnet generation) with
# inputs, outputs and token usage. Tracing failures never fail a request.
LEXORA_LANGFUSE_PUBLIC_KEY=
LEXORA_LANGFUSE_SECRET_KEY=
LEXORA_LANGFUSE_HOST=https://cloud.langfuse.com

# ── Service ──────────────────────────────────────────────────────────────────
# Comma-separated allowlist. Never "*": the API sends no credentials and says so.
LEXORA_CORS_ALLOW_ORIGINS=http://localhost:3020,http://127.0.0.1:3020
LEXORA_RATE_LIMIT=30/minute

# ── Retrieval (defaults shown; all measured, see AUDIT.md) ───────────────────
LEXORA_DENSE_TOP_K=20
LEXORA_SPARSE_TOP_K=20
LEXORA_RRF_K=60
LEXORA_FUSED_TOP_K=20
LEXORA_RERANK_TOP_K=5
LEXORA_CHUNK_TARGET_TOKENS=600
LEXORA_CHUNK_OVERLAP_TOKENS=80

# Cross-encoder. The default was chosen by measurement over BAAI/bge-reranker-base:
# better hit@1, 5x faster, and a far cleaner refusal margin. See AUDIT.md.
LEXORA_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# Refusal floor on the best cross-encoder score. Calibrated against the labelled
# eval set (`make calibrate`), not guessed. Model-specific — regenerate it if you
# change LEXORA_RERANKER_MODEL.
LEXORA_REFUSAL_SCORE_FLOOR=-3.6
